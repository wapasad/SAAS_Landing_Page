# Optional Vercel Environment Variables (Demo Mode works even without setting these)
SECRET_KEY=replace_with_a_long_random_secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_strong_password
ADMIN_TOKEN=replace_with_a_long_random_token

# Demo Mode is automatically enabled on Vercel when DATABASE_URL is not set.
# You can also force Demo Mode locally with:
# DEMO_MODE=true
